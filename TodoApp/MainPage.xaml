                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FluentQuickIssueTextBox" AutomationProperties.AutomationId="FluentQuickIssueTextBox"
                                 PlaceholderText="빠르게 추가할 이슈 제목" KeyDown="FluentQuickIssueTextBox_KeyDown" />
                        <Button Grid.Column="1" AutomationProperties.AutomationId="FluentAddQuickIssueButton"
                                AutomationProperties.Name="빠른 이슈 추가" Click="FluentAddQuickIssue_Click" Content="추가" Padding="18,8" />
                    </Grid>
                </Grid>
                <Border x:Name="FluentInspector" Grid.Column="1" Padding="16" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="FluentDetailEmptyState" VerticalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE8A5;" FontSize="28" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="이슈를 선택하세요" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="목록에서 이슈를 선택하면 여기서 내용과 진행 상태를 확인할 수 있습니다."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ScrollViewer
                        x:Name="FluentDetailEditor"
                        Visibility="Collapsed">
                        <ScrollViewer.Resources>
                            <DataTemplate x:Key="FluentFieldHeader">
                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                                <Setter Property="HeaderTemplate" Value="{StaticResource FluentFieldHeader}" />
                            </Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                                <Setter Property="HeaderTemplate" Value="{StaticResource FluentFieldHeader}" />
                            </Style>
                        </ScrollViewer.Resources>
                        <StackPanel Spacing="12">
                            <TextBlock Text="이슈 상세" FontSize="20" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="FluentSelectedKeyTextBlock"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="FluentSelectedStatusTextBlock"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Grid>

                            <TextBox
                                x:Name="FluentIssueTitleTextBox"
                                AutomationProperties.AutomationId="FluentIssueTitleTextBox"
                                Header="제목" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" AcceptsReturn="False" />
                            <TextBox
                                x:Name="FluentIssueDescriptionTextBox"
                                AcceptsReturn="True"
                                AutomationProperties.AutomationId="FluentIssueDescriptionTextBox"
                                Header="설명"
                                Height="92"
                                TextWrapping="Wrap" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="FluentDetailStatusComboBox"
                                    AutomationProperties.AutomationId="FluentDetailStatusComboBox"
                                    Header="상태"
                                    HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="백로그" Tag="Backlog" />
                                    <ComboBoxItem Content="예정" Tag="Todo" />
                                    <ComboBoxItem Content="진행 중" Tag="InProgress" />
                                    <ComboBoxItem Content="리뷰" Tag="Review" />
                                    <ComboBoxItem Content="완료" Tag="Done" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="FluentDetailPriorityComboBox"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="FluentDetailPriorityComboBox"
                                    Header="우선순위"
                                    HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="긴급" Tag="Urgent" />
                                    <ComboBoxItem Content="높음" Tag="High" />
                                    <ComboBoxItem Content="보통" Tag="Medium" />
                                    <ComboBoxItem Content="낮음" Tag="Low" />
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="FluentDetailProjectComboBox"
                                    AutomationProperties.AutomationId="FluentDetailProjectComboBox"
                                    Header="프로젝트"
                                    HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Platform" Tag="Platform" />
                                    <ComboBoxItem Content="Mobile" Tag="Mobile" />
                                    <ComboBoxItem Content="Growth" Tag="Growth" />
                                    <ComboBoxItem Content="Ops" Tag="Ops" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="FluentDetailAssigneeComboBox"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="FluentDetailAssigneeComboBox"
                                    Header="담당자"
                                    HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="나" Tag="나" />
                                    <ComboBoxItem Content="Design" Tag="Design" />
                                    <ComboBoxItem Content="Backend" Tag="Backend" />
                                    <ComboBoxItem Content="QA" Tag="QA" />
                                </ComboBox>
                            </Grid>

                            <TextBox
                                x:Name="FluentIssueDueDateTextBox"
                                AutomationProperties.AutomationId="FluentIssueDueDateTextBox"
                                Header="기한" PlaceholderText="YYYY-MM-DD" />
                            <TextBox
                                x:Name="FluentIssueLabelsTextBox"
                                AutomationProperties.AutomationId="FluentIssueLabelsTextBox"
                                Header="라벨" PlaceholderText="예: ux, core" />


                        </StackPanel>
                    </ScrollViewer>
                        <Border Grid.Row="1" BorderThickness="0,1,0,0" Padding="0,8,0,0"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Visibility="{Binding Visibility, ElementName=FluentDetailEditor}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="FluentDetailHintTextBlock" Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <CommandBar
                                    Grid.Column="1"
                                    DefaultLabelPosition="Right"
                                    IsOpen="False">
                                    <AppBarButton
                                        AutomationProperties.AutomationId="FluentSaveIssueButton"
                                        Icon="Save"
                                        Label="저장"
                                        Click="FluentSaveIssue_Click" />
                                    <AppBarButton
                                        AutomationProperties.AutomationId="FluentDeleteIssueButton"
                                        Icon="Delete"
                                        Label="삭제"
                                        Click="DeleteSelectedIssue_Click" />
                                </CommandBar>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </NavigationView>
    </Grid>
</Page>